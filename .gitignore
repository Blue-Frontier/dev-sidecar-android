# 构建产物
build/
smoke/out/
*.apk
*.keystore
# 不提交任何签名密钥：本地构建在 ~/.ds-next/ 生成开发用密钥，
# 发布构建必须用 CI 的 DS_KEYSTORE_B64 私有密钥。

# 依赖暂存（将来走 Maven CLI 拉取）
lib/

# 编辑器/系统杂项
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# 事故恢复用的临时反编译对照（不入库）
.recover/
_probe/

# 内核 AAR 的派生产物，由 kernel/ 源码构建并 sync 出来
libs/

# AAR 依赖解出的 jar，由 deps/fetch-deps.ps1 生成
deps/jars/
deps/*.aar
# ...but the AARs checked in for offline builds are kept.
!deps/vendor/

