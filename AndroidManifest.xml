<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.blueFrontier.devSideCar.next.android"
    android:versionCode="300"
    android:versionName="0.3.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- usesCleartextTraffic: the CONNECT to the HTTP proxy is plain text. -->
    <application
        android:label="DS NEXT"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KernelSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    <activity
        android:name=".DownloadsActivity"
        android:exported="true"
        android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".GithubStatusActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".TrafficActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Serves files/kernel.log as a content:// URI so the share sheet can
             hand it to WeChat/mail; only that one file is reachable. -->
        <provider
            android:name=".LogProvider"
            android:authorities="org.blueFrontier.devSideCar.next.android.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Keeps the process, and therefore the in-process Go kernel, alive
             while the app is in the background. -->
        <service
            android:name=".KernelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="embedded dev-sidecar proxy kernel" />
        </service>
    </application>
</manifest>















