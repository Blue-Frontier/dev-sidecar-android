<?xml version="1.0" encoding="utf-8"?>
<!-- The kernel mints its CA on this device at first start, so there is no
     static anchor to declare here. Chains it signs are accepted in
     MainActivity.onReceivedSslError after checking them against
     files/ca/ca.crt; everything else still goes through the system store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
